{
  "crons": [
    {
      "path": "/api/cleanup-event-flyers",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/checkin",
      "destination": "/checkin.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/videos",
      "destination": "/videos.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/checkin.html",
      "destination": "/checkin",
      "permanent": true
    },
    {
      "source": "/events.html",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/videos.html",
      "destination": "/videos",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    }
  ]
}
